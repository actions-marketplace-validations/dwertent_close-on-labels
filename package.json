{
  "name": "close-on-labels",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that closes issues and pull requests when their labels match a rule.",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --legal-comments=none --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "all": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
